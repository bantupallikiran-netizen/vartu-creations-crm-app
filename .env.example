# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================================
# SQL Server (mssql + msnodesqlv8) Persistent Database Configuration
# Windows Integrated Authentication (Trusted Connection)
# Architecture: React Frontend -> Node.js Backend API -> SQL Server (VartuCRM)
#
# NOTE: Windows Authentication connects using your currently logged-in
# Windows account (the same account you use in SSMS).
# No 'sa' account, DB_USER, or DB_PASSWORD is required!
# ==========================================================
DB_SERVER="DESKTOP-BQDO1QT"
DB_DATABASE="VartuCRM"

# Optional: If you are using a named instance (e.g. DESKTOP-BQDO1QT\SQLEXPRESS), set it here:
# DB_INSTANCE_NAME="SQLEXPRESS"

# Optional: Specific ODBC driver installed on your Windows machine.
# By default, the backend automatically detects and tries:
# 'ODBC Driver 17 for SQL Server', 'ODBC Driver 18 for SQL Server', 'SQL Server', 'SQL Server Native Client 11.0'
# DB_ODBC_DRIVER="ODBC Driver 17 for SQL Server"

# Optional custom connection string override (leave unset for automatic trusted connection string):
# DB_CONNECTION_STRING="Server=DESKTOP-BQDO1QT;Database=VartuCRM;Trusted_Connection=Yes;TrustServerCertificate=Yes;Driver={ODBC Driver 17 for SQL Server};"


